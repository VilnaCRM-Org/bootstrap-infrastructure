[importlinter]
root_packages =
    infra
    policy_pack
    scripts

[importlinter:contract:infra_does_not_import_policy_pack]
name = Pulumi runtime modules must stay independent from policy-pack code
type = forbidden
source_modules =
    infra
forbidden_modules =
    policy_pack

[importlinter:contract:infra_does_not_import_scripts]
name = Pulumi runtime modules must not depend on operational scripts
type = forbidden
source_modules =
    infra
forbidden_modules =
    scripts

[importlinter:contract:policy_pack_does_not_import_infra]
name = Policy pack modules must stay isolated from deploy/runtime modules
type = forbidden
source_modules =
    policy_pack
forbidden_modules =
    infra

[importlinter:contract:policy_pack_does_not_import_scripts]
name = Policy pack modules must not depend on operational scripts
type = forbidden
source_modules =
    policy_pack
forbidden_modules =
    scripts

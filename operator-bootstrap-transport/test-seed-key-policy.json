{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountRootAdministration",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::891377212104:root"
      },
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::891377212104:root"
        }
      }
    },
    {
      "Sid": "EnrolledOperatorMetadataOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "kms:DescribeKey",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::891377212104:role/GitHubOperatorPreview-test",
            "arn:aws:iam::891377212104:role/GitHubOperatorApply-test",
            "arn:aws:iam::891377212104:role/GitHubOperatorDrift-test"
          ]
        }
      }
    }
  ]
}

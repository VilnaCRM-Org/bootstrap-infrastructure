# Create this stack with an AWS KMS secrets provider before the first `pulumi up`:
# pulumi -C pulumi stack init prod --secrets-provider "awskms://alias/pulumi-platform-bootstrap-prod?region=eu-central-1"
config:
  aws:region: eu-central-1
  bootstrap-infrastructure:githubOrg: VilnaCRM-Org
  bootstrap-infrastructure:repoSlug: bootstrap-infrastructure
  bootstrap-infrastructure:environment: prod
  bootstrap-infrastructure:owner: platform
  bootstrap-infrastructure:costCenter: core
  bootstrap-infrastructure:githubBranch: main

{
  "statements": [
    {
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "ecr:CreateRepository",
        "ecr:TagResource",
        "ecr:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ecr:eu-central-1:891377212104:repository/user-service-test-web",
        "arn:aws:ecr:eu-central-1:891377212104:repository/user-service-test-worker"
      ],
      "Sid": "PocRegistryMetadata"
    },
    {
      "Action": [
        "ses:GetEmailIdentity",
        "ses:ListTagsForResource",
        "ses:CreateEmailIdentity",
        "ses:TagResource",
        "ses:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ses:eu-central-1:891377212104:identity/user.vilnacrmtest.com"
      ],
      "Sid": "PocMailIdentityMetadata"
    },
    {
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:route53:::hostedzone/Z04999481RZ4UQK2NANVH"
      ],
      "Sid": "PocDkimZoneMetadata"
    },
    {
      "Action": [
        "s3:GetBucketVersioning"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::pulumi-user-service-infrastructure-test-state"
      ],
      "Sid": "PocBackendVersioning"
    },
    {
      "Action": [
        "route53:GetChange"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:route53:::change/*"
      ],
      "Sid": "PocDkimChangeStatus"
    },
    {
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsActions": [
            "CREATE"
          ],
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "CNAME"
          ]
        },
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "*._domainkey.user.vilnacrmtest.com"
          ]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsActions": "false",
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:route53:::hostedzone/Z04999481RZ4UQK2NANVH"
      ],
      "Sid": "PocDkimRecords"
    }
  ],
  "version": "test-poc-prerequisites/v1"
}
